{
  "bindings": [
    {
      "type": "httpTrigger",
      "direction": "in",
      "name": "req",
      "methods": ["get", "post", "options"],
      "route": "items",
      "cors": {
        "origin": ["http://localhost:3000", "*"],
        "allowMethods": ["GET", "POST", "OPTIONS"],
        "allowHeaders": ["*"]
      }
    },
    {
      "type": "http",
      "direction": "out",
      "name": "res"
    }
  ]
}